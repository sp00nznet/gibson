{
  "name": "gibson",
  "version": "0.16.0",
  "description": "GIBSON: a cracktro terminal. Wireframe worlds, reactive techno, and NYX, the unseen sysop who watches you type.",
  "author": "sp00nznet",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node sync.js && node test/check.mjs && node test/irc-check.mjs && node test/theatre-check.mjs && node bbs/check.js",
    "shots": "node scripts/shots.mjs",
    "dist": "electron-builder --publish never",
    "icon": "electron scripts/icon.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "chiptune3": "0.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sp00nznet/gibson.git"
  },
  "homepage": "https://github.com/sp00nznet/gibson",
  "build": {
    "appId": "net.sp00nz.gibson",
    "productName": "GIBSON",
    "files": [
      "main.js",
      "llm.js",
      "sysinfo.js",
      "bbs/**",
      "irc.js",
      "sync.js",
      "preload.js",
      "renderer/**",
      "LICENSE",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "bbs/**"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "sp00nznet"
    }
  }
}
